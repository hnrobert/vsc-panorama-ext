  "webOnly": {
    "display": {
      "zh-cn": "Panorama 没有 display。用 flow-children 控制子元素排列方向",
      "en": "Panorama has no display. Use flow-children to control the direction children are laid out in"
    },
    "float": {
      "zh-cn": "Panorama 没有 float。用 flow-children 与 horizontal-align",
      "en": "Panorama has no float. Use flow-children together with horizontal-align"
    },
    "flex": {
      "zh-cn": "Panorama 没有 flex。用 flow-children + fill-parent-flow(权重)",
      "en": "Panorama has no flex. Use flow-children + fill-parent-flow(weight)"
    },
    "flex-direction": {
      "zh-cn": "用 flow-children: down | right | left | up",
      "en": "Use flow-children: down | right | left | up"
    },
    "flex-grow": {
      "zh-cn": "用 width: fill-parent-flow(权重) 或 height: fill-parent-flow(权重)",
      "en": "Use width: fill-parent-flow(weight) or height: fill-parent-flow(weight)"
    },
    "flex-wrap": {
      "zh-cn": "用 flow-children 的 -wrap 变体，如 right-wrap",
      "en": "Use the -wrap variants of flow-children, such as right-wrap"
    },
    "flex-basis": {
      "zh-cn": "Panorama 没有 flex-basis。直接写 width / height",
      "en": "Panorama has no flex-basis. Write width / height directly"
    },
    "grid": {
      "zh-cn": "Panorama 没有 grid。用嵌套 Panel + flow-children",
      "en": "Panorama has no grid. Use nested Panels with flow-children"
    },
    "grid-template-columns": {
      "zh-cn": "Panorama 没有 grid。用嵌套 Panel + flow-children: right",
      "en": "Panorama has no grid. Use nested Panels with flow-children: right"
    },
    "grid-template-rows": {
      "zh-cn": "Panorama 没有 grid。用嵌套 Panel + flow-children: down",
      "en": "Panorama has no grid. Use nested Panels with flow-children: down"
    },
    "justify-content": {
      "zh-cn": "用 horizontal-align 或 vertical-align",
      "en": "Use horizontal-align or vertical-align"
    },
    "align-items": {
      "zh-cn": "用 horizontal-align 或 vertical-align",
      "en": "Use horizontal-align or vertical-align"
    },
    "align-self": {
      "zh-cn": "用 horizontal-align 或 vertical-align",
      "en": "Use horizontal-align or vertical-align"
    },
    "box-sizing": {
      "zh-cn": "Panorama 没有 box-sizing",
      "en": "Panorama has no box-sizing"
    },
    "transition": {
      "zh-cn": "Panorama 不做多属性简写展开，transition 简写整条静默失效。拆成 transition-property / -duration / -timing-function / -delay 四条",
      "en": "Panorama does not expand multi-property shorthands, so a transition shorthand silently does nothing. Split it into transition-property / -duration / -timing-function / -delay"
    }
  }
}
