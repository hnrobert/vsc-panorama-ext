  "functions": [
    {
      "name": "fill-parent-flow",
      "signature": {
        "zh-cn": "fill-parent-flow(权重)",
        "en": "fill-parent-flow(weight)"
      },
      "description": {
        "zh-cn": "沿 flow 方向按权重填满剩余空间，近似 flex-grow",
        "en": "Fills the remaining space along the flow direction, distributed by weight; close to flex-grow"
      }
    },
    {
      "name": "width-percentage",
      "signature": {
        "zh-cn": "width-percentage(百分比)",
        "en": "width-percentage(percentage)"
      },
      "description": {
        "zh-cn": "尺寸 = 本面板自身宽度的百分比，用于锁宽高比",
        "en": "Size = a percentage of this panel's own width; used to lock an aspect ratio"
      }
    },
    {
      "name": "height-percentage",
      "signature": {
        "zh-cn": "height-percentage(百分比)",
        "en": "height-percentage(percentage)"
      },
      "description": {
        "zh-cn": "尺寸 = 本面板自身高度的百分比，用于锁宽高比",
        "en": "Size = a percentage of this panel's own height; used to lock an aspect ratio"
      }
    },
    {
      "name": "gradient",
      "signature": {
        "zh-cn": "gradient(linear|radial, x0 y0, x1 y1, from(c1), color-stop(t, c2), to(c3))",
        "en": "gradient(linear|radial, x0 y0, x1 y1, from(c1), color-stop(t, c2), to(c3))"
      },
      "description": {
        "zh-cn": "渐变",
        "en": "Gradient"
      }
    },
    {
      "name": "gaussian",
      "signature": {
        "zh-cn": "gaussian(标准差) | gaussian(x, y, passes)",
        "en": "gaussian(std-dev) | gaussian(x, y, passes)"
      },
      "description": {
        "zh-cn": "高斯模糊参数。passes>1 很伤性能",
        "en": "Gaussian blur parameters. passes > 1 is very expensive"
      }
    },
    {
      "name": "mipmapgaussian",
      "signature": {
        "zh-cn": "mipmapgaussian(x, y, passes)",
        "en": "mipmapgaussian(x, y, passes)"
      },
      "description": {
        "zh-cn": "带 1/4 降采样的高斯，仅用于 world-blur",
        "en": "Gaussian with 1/4 downsampling; world-blur only"
      }
    },
    {
      "name": "rect",
      "signature": {
        "zh-cn": "rect(top, right, bottom, left)",
        "en": "rect(top, right, bottom, left)"
      },
      "description": {
        "zh-cn": "clip 的矩形裁剪",
        "en": "Rectangular clip for clip"
      }
    },
    {
      "name": "radial",
      "signature": {
        "zh-cn": "radial(圆心, 起始角, 角宽度)",
        "en": "radial(center, start-angle, angle-width)"
      },
      "description": {
        "zh-cn": "clip 的径向裁剪；第三参为角度跨度，不是结束角",
        "en": "Radial clip for clip; the third argument is the angular span, not the end angle"
      }
    },
    {
      "name": "url",
      "signature": {
        "zh-cn": "url(\"s2r://...\")",
        "en": "url(\"s2r://...\")"
      },
      "description": {
        "zh-cn": "资源引用",
        "en": "Resource reference"
      }
    },
    {
      "name": "min",
      "signature": {
        "zh-cn": "min(Npx)",
        "en": "min(Npx)"
      },
      "description": {
        "zh-cn": "text-overflow: shrink 的最小字号修饰",
        "en": "Minimum font size modifier for text-overflow: shrink"
      }
    }
  ],
  "atRules": {
    "@define": {
      "signature": {
        "zh-cn": "@define 名字: 值;",
        "en": "@define name: value;"
      },
      "description": {
        "zh-cn": "常量声明，编译期文本替换。引用时直接写名字，不用 var()",
        "en": "Constant declaration, substituted textually at compile time. Reference it by name directly — no var()"
      }
    },
    "@import": {
      "signature": {
        "zh-cn": "@import url(\"s2r://...vcss_c\");",
        "en": "@import url(\"s2r://...vcss_c\");"
      },
      "description": {
        "zh-cn": "导入样式表，用编译路径",
        "en": "Imports a stylesheet, using the compiled path"
      }
    },
    "@keyframes": {
      "signature": {
        "zh-cn": "@keyframes '名字' { ... }",
        "en": "@keyframes 'name' { ... }"
      },
      "description": {
        "zh-cn": "关键帧。⚠️ 名字必须加引号",
        "en": "⚠️ Keyframes. The name must be quoted"
      }
    }
  },
