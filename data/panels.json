  "attributeDocs": {
    "audible-seconds": "The number of seconds remaining before we start playing counter sounds every second.",
    "defaultfastzoom": "Normally false. If true, use fast zoom unless explicitly told not to.",
    "dragclickzone": "If >= 0, drags longer than this distance will suppress mouse click events (e.g. onactivate of embedded panels)",
    "framecount": "If set, how many frames in the sprite sheet. Default assumes every space in image is filled.",
    "invertminscalecalc": "If this is > 0, the min scale is set to account for the higher value, where the smaller dimension is maxed out first",
    "loopcount": "If 'loop = true', how many times to loop before stopping. -1 == infinite",
    "minscale": "Just ignore the calculations, you can zoom to this amount (will validate that this is <= maxscale)",
    "multitouchzoomscale": "Scale for the pinch zoom gesture.",
    "popupfullscreenopaque": "Boolean to indicate that this popup ends up full screen opaque following any initial transitions. From this we know any panels underneath can be safely hidden.",
    "src-id": "required with src",
    "src-parameters": "optional with src",
    "strictclamptranslation": "If this is > 0, don't let the content panel translate in a way that would let you see through the frame",
    "textureheight": "texturewidth and textureheight can be used to override the size of vector graphics. Default value of -1 indicates texture width/height to be determined from source file",
    "texturewidth": "texturewidth and textureheight can be used to override the size of vector graphics. Default value of -1 indicates texture width/height to be determined from source file"
  },
